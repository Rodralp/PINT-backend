{
  "name": "pint-web-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:create": "node src/scripts/createDatabase.js",
    "db:init": "node src/scripts/initSchema.js",
    "db:setup": "npm run db:create && npm run db:init",
    "db:migrate:badge-types": "node src/scripts/migrateBadgeTypesAndNames.js",
    "db:check": "node src/scripts/checkDatabase.js",
    "db:recreate": "node src/scripts/recreateDatabase.js",
    "db:setup:full": "node src/scripts/setupDatabase.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.10",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  }
}